  const languageSelector = buildLanguageSelector(ctx);
  if (languageSelector) {
    builder.addSection(CardService.newCardSection().addWidget(languageSelector));
  }

  builder.addSection(
    CardService.newCardSection()
      .setCollapsible(false)
      .setNumUncollapsibleWidgets(1)
